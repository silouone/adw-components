exports[`<GraphDrawerView/> — snapshots empty 1`] = `"<aside class="bl-gd dock-bottom" style="left: 0px; right: 0px; height: 346px;"><div class="bl-gd-drag"></div><header class="bl-gd-head"><span class="bl-gd-title">⎇ graph</span><span class="bl-gd-chips"><button type="button" data-gproj="empty" class="bl-gd-chip on">empty</button></span><span class="bl-gd-seg"><button type="button" data-dock="bottom" class="bl-gd-btn on">⬓ bottom</button><button type="button" data-dock="right" class="bl-gd-btn">◨ right</button></span><span class="bl-gd-seg"><button type="button" data-size="narrow" class="bl-gd-btn on">narrow</button><button type="button" data-size="wide" class="bl-gd-btn">wide</button><button type="button" data-size="full" class="bl-gd-btn">full</button></span><button type="button" class="bl-gd-x" aria-label="close the graph">×</button></header><p class="bl-gd-empty">no dependency graph for empty</p><footer class="bl-gd-legend"><span><i class="bl-gd-sw bl-gd-sw-crit"></i> critical path</span><span><i class="bl-gd-sw bl-gd-sw-unmet"></i> unmet dep</span><span><i class="bl-gd-sw bl-gd-sw-met"></i> met dep</span><span><i class="bl-gd-sw bl-gd-sw-dashed"></i> outside / manual</span><span>drag to pan · ⌘/ctrl-wheel or pinch to zoom · - 0 + f</span></footer></aside>"`;

