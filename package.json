{
  "name": "adw-components-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "ds:check": "echo 'ds:check: no rules yet (adw-components-15)'",
    "lint": "bun run ds:check && biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "bun run --filter './packages/*' build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:publish": "bash scripts/publish-storybook.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@preact/signals": "^2.11.2",
    "@storybook/addon-a11y": "^10.6",
    "@storybook/addon-docs": "^10.6",
    "@storybook/preact-vite": "^10.6",
    "@testing-library/preact": "^3.2.4",
    "bun-types": "^1.2.0",
    "preact": "^10.29.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6",
    "typescript": "^5.8.0",
    "vite": "^8.3.5"
  }
}
